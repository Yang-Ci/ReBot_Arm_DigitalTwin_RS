         solref/solimp 使约束更硬，减少臂运动时 left/right 相对 joint7 的滞后。 -->
    <joint joint1="joint7" joint2="joint_left"  polycoef="0 1 0 0 0" solref="0.001 1" solimp="0.99 0.99 0.001"/>
    <joint joint1="joint7" joint2="joint_right" polycoef="0 1 0 0 0" solref="0.001 1" solimp="0.99 0.99 0.001"/>
  </equality>
  <contact>
    <!-- The convex collision pieces on the two fingers share cut-plane seams.
         They must collide with grasped objects, but not with each other;
         otherwise those internal seams friction-lock the opening stroke.  This
         matches the validated DM gripper collision model. -->
    <exclude body1="gripper_left" body2="gripper_right"/>
  </contact>
  <actuator>
    <!-- 臂关节作动器使用 <motor>：由 Python 中的 POS_VEL 串级控制器驱动。
         ctrl 为关节力矩（N·m），ctrlrange 对应真实电机输出力矩限制。
         位置环/速度环参数在代码中配置，与真实电机 POS_VEL 模式一致。 -->
    <motor name="joint1_motor" joint="joint1" ctrlrange="-36 36" gear="1" />
    <motor name="joint2_motor" joint="joint2" ctrlrange="-36 36" gear="1" />
    <motor name="joint3_motor" joint="joint3" ctrlrange="-36 36" gear="1" />
    <motor name="joint4_motor" joint="joint4" ctrlrange="-14 14" gear="1" />
    <motor name="joint5_motor" joint="joint5" ctrlrange="-14 14" gear="1" />
    <motor name="joint6_motor" joint="joint6" ctrlrange="-14 14" gear="1" />
    <!-- 夹爪由 joint7 驱动；joint_left / joint_right 通过 equality 约束与 joint7 联动。
         这里给 joint7 加 <motor>，由 Python 中的 PD 控制器驱动。
         注意：若用于 real-to-sim，此作动器应禁用，改由真实电机位置直接驱动。 -->
    <motor name="joint7_motor" joint="joint7" ctrlrange="-500 500" gear="1" />
  </actuator>
